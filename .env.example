# Leads Marketing Tool — environment template
# Copy to .env.local (cp .env.example .env.local) and fill in what you have.
# NEVER commit real secrets. .env* files are git-ignored (except this example).

# --- Database (required) ---------------------------------------------------
# Local Docker: `docker compose up -d` starts Postgres with these credentials.
# Use 127.0.0.1 (not localhost) to avoid IPv6 issues on macOS.
DATABASE_URL="postgresql://leads:leads@127.0.0.1:5432/leads_marketing?schema=public&connect_timeout=10"
DIRECT_URL="postgresql://leads:leads@127.0.0.1:5432/leads_marketing?schema=public&connect_timeout=10"

# --- App ---------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Local single-operator mode (no Supabase Auth). Set to false and configure Supabase for multi-user.
DEV_AUTH_ENABLED="true"

# --- AI (optional; heuristic mode is used when no key is set) ---------------
# openrouter (recommended, has free models) | openai
AI_PROVIDER=openrouter
# Get a free key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your-openrouter-key-here
# Or use OpenAI directly (set AI_PROVIDER=openai): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model id. OpenRouter free options: "openrouter/free" (auto-picks a free model) or any id ending in ":free"
# (see https://openrouter.ai/models?max_price=0). OpenAI example: gpt-4o-mini
AI_MODEL=openrouter/free
# Optional: any other OpenAI-compatible endpoint (overrides the provider base URL).
# AI_BASE_URL=
# Voice (speech-to-text / text-to-speech) needs AI_PROVIDER=openai; otherwise browser speech is used.
OPENAI_STT_MODEL="whisper-1"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="coral"
# Encrypts API keys stored in Postgres. Generate one: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# --- Apify (lead discovery). Bring your own token ---------------------------
# https://console.apify.com/settings/integrations  (free plan includes monthly credit)
APIFY_TOKEN=your-apify-token-here

# --- Business Profile (optional) ---------------------------------------------
# Path to a JSON profile (see business-profile.example.json). Default: ./business-profile.json
# The profile can also be edited in the app at Settings → Business Profile.
# BUSINESS_PROFILE_PATH=./business-profile.json

# --- Email (Gmail OAuth for import/export + sending) -------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
# Optional default Google Sheet id for lead import.
# GOOGLE_SHEET_ID=
# Sender identity. Defaults to the connected Google account.
# OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME="Your Business"
# Physical postal address shown in the email footer (required by CAN-SPAM and similar laws).
OUTREACH_SENDER_ADDRESS="123 Example Street, City, Country"
# Footer with sender identity + unsubscribe instructions. Keep true unless your template has its own.
EMAIL_COMPLIANCE_FOOTER=true

# --- Safety -------------------------------------------------------------------
# The global kill switch (Outreach → Engine → "Pause all sends") is ON by default in a new database.
# Nothing is sent until you explicitly turn it off in the UI.
# Shared secret for /api/queue/process (x-queue-secret or Authorization: Bearer).
QUEUE_PROCESS_SECRET=
# Conservative daily caps. HARD_* ceilings in src/lib/outreach/policy.ts still apply.
JARVIS_DAILY_SEND_LIMIT=10
JARVIS_LINKEDIN_CONNECTION_DAILY_CAP=10
JARVIS_LINKEDIN_MESSAGE_DAILY_CAP=10
JARVIS_TWITTER_DM_DAILY_CAP=10
SCRAPING_KILL_SWITCH="false"

# --- OPTIONAL MODULE: LinkedIn / X browser automation (OFF) --------------------
# WARNING: LinkedIn's User Agreement and X's Terms prohibit automated activity.
# Enabling this can get your accounts restricted or banned. Read README → Compliance first.
ENABLE_SOCIAL_AUTOMATION=false
# Public scheduler link used by the /go/linkedin hop (Calendly, Cal.com…).
LINKEDIN_SCHEDULER_URL=

# --- Optional providers -------------------------------------------------------
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL="https://api.firecrawl.dev"
CRAWLEE_IN_NEXT="true"
# PLAYWRIGHT_CHANNEL="chrome"
# People Data Labs (licensed person enrichment).
PDL_API_KEY=
LINKEDIN_RESEARCH_PROVIDER=
INSTAGRAM_RESEARCH_PROVIDER=
LINKEDIN_CONNECTION_STATUS_PROVIDER=

# --- Supabase (optional; multi-user auth) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
